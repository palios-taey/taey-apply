{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palios-taey.org/schemas/application-context-v1.json",
  "title": "Opaque private autonomous application context",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "taey_apply_application_context_v1"},
    "provider": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
    "application_identity_sha256": {"$ref": "#/$defs/digest"},
    "source_manifest_sha256": {"$ref": "#/$defs/digest"},
    "required_fact_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "application-materialization-manifest-v1.json#/$defs/token"
      }
    },
    "stages": {
      "$ref": "application-materialization-manifest-v1.json#/properties/stages"
    },
    "applicant_facts": {
      "$ref": "application-materialization-manifest-v1.json#/$defs/facts"
    },
    "work_evidence": {
      "$ref": "application-materialization-manifest-v1.json#/$defs/work_evidence"
    },
    "submission_policy": {
      "$ref": "application-materialization-manifest-v1.json#/$defs/submission_policy"
    },
    "truth_attestation_sha256": {"$ref": "#/$defs/digest"}
  },
  "required": [
    "schema",
    "provider",
    "application_identity_sha256",
    "source_manifest_sha256",
    "required_fact_keys",
    "stages",
    "applicant_facts",
    "work_evidence",
    "submission_policy",
    "truth_attestation_sha256"
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
