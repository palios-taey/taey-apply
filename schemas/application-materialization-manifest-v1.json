{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palios-taey.org/schemas/application-materialization-manifest-v1.json",
  "title": "Private autonomous application materialization manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "taey_apply_application_materialization_manifest_v1"},
    "operation": {"const": "materialize_autonomous_application"},
    "provider": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
    "application_identity_sha256": {"$ref": "#/$defs/digest"},
    "maximum_one_action_calls": {"type": "integer", "minimum": 1, "maximum": 256},
    "required_fact_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/token"}
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "discovery": {"$ref": "#/$defs/discovery_stage"},
        "qualification": {"$ref": "#/$defs/qualification_stage"},
        "deep_research": {"$ref": "#/$defs/deep_research_stage"},
        "materials": {"$ref": "#/$defs/materials_stage"}
      },
      "required": ["discovery", "qualification", "deep_research", "materials"]
    },
    "applicant_facts": {"$ref": "#/$defs/facts"},
    "work_evidence": {"$ref": "#/$defs/work_evidence"},
    "submission_policy": {"$ref": "#/$defs/submission_policy"}
  },
  "required": [
    "schema",
    "operation",
    "provider",
    "application_identity_sha256",
    "maximum_one_action_calls",
    "required_fact_keys",
    "stages",
    "applicant_facts",
    "work_evidence",
    "submission_policy"
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "token": {
      "type": "string",
      "pattern": "^(?!(?:approval_required|human_approval|human_review_required|review_queue)$)[a-z][a-z0-9_]{0,127}$"
    },
    "private_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*//)[^\\u0000-\\u001f\\u007f]+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"$ref": "#/$defs/token"},
        "ref": {"$ref": "#/$defs/private_ref"},
        "sha256": {"$ref": "#/$defs/digest"},
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"
        }
      },
      "required": ["kind", "ref", "sha256", "media_type"]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "discovery_stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {"const": "discovered"},
        "artifacts": {"$ref": "#/$defs/artifacts"}
      },
      "required": ["state", "artifacts"]
    },
    "qualification_stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {"const": "qualified"},
        "artifacts": {"$ref": "#/$defs/artifacts"}
      },
      "required": ["state", "artifacts"]
    },
    "deep_research_stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {"const": "deep_research_complete"},
        "artifacts": {"$ref": "#/$defs/artifacts"}
      },
      "required": ["state", "artifacts"]
    },
    "materials_stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {"const": "materials_ready"},
        "artifacts": {"$ref": "#/$defs/artifacts"}
      },
      "required": ["state", "artifacts"]
    },
    "private_value": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "boolean"},
        {"type": "integer"},
        {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {"$ref": "#/$defs/private_value"},
        "evidence_sha256": {"$ref": "#/$defs/digest"}
      },
      "required": ["value", "evidence_sha256"]
    },
    "facts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/token"},
      "additionalProperties": {"$ref": "#/$defs/fact"}
    },
    "work_claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "evidence_sha256": {"$ref": "#/$defs/digest"}
      },
      "required": ["statement", "evidence_sha256"]
    },
    "work_evidence": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/token"},
      "additionalProperties": {"$ref": "#/$defs/work_claim"}
    },
    "directive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {"$ref": "#/$defs/private_value"},
        "evidence_sha256": {"$ref": "#/$defs/digest"}
      },
      "required": ["value", "evidence_sha256"]
    },
    "submission_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "submission_authorized": {"const": true},
        "directives": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/token"},
          "additionalProperties": {"$ref": "#/$defs/directive"}
        }
      },
      "required": ["submission_authorized", "directives"]
    }
  }
}
