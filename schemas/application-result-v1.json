{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palios-taey.org/schemas/application-result-v1.json",
  "title": "Compact autonomous application result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "taey_apply_application_result_v1"},
    "ok": {"type": "boolean"},
    "state": {
      "enum": ["employer_confirmation_proven", "terminal_halt", "side_effect_uncertain"]
    },
    "failure_code": {
      "type": ["string", "null"],
      "enum": [
        null,
        "exact_postcondition_failure",
        "unmapped_ui_or_question",
        "missing_truthful_applicant_data",
        "policy_or_authority_boundary",
        "side_effect_uncertainty"
      ]
    },
    "provider": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
    "application_identity_sha256": {"$ref": "application-lifecycle-v1.json#/$defs/digest"},
    "envelope_sha256": {"$ref": "application-lifecycle-v1.json#/$defs/digest"},
    "attempt_sha256": {"$ref": "application-lifecycle-v1.json#/$defs/digest"},
    "one_action_calls": {"type": "integer", "minimum": 0, "maximum": 256},
    "ui_mutations": {
      "anyOf": [
        {"type": "integer", "minimum": 0, "maximum": 256},
        {"type": "null"}
      ]
    },
    "confirmation_sha256": {
      "anyOf": [
        {"$ref": "application-lifecycle-v1.json#/$defs/digest"},
        {"type": "null"}
      ]
    },
    "receipt_chain_sha256": {"$ref": "application-lifecycle-v1.json#/$defs/digest"},
    "receipt_sha256": {"$ref": "application-lifecycle-v1.json#/$defs/digest"},
    "next_mutation_authorized": {"const": false}
  },
  "required": [
    "schema",
    "ok",
    "state",
    "failure_code",
    "provider",
    "application_identity_sha256",
    "envelope_sha256",
    "attempt_sha256",
    "one_action_calls",
    "ui_mutations",
    "confirmation_sha256",
    "receipt_chain_sha256",
    "receipt_sha256",
    "next_mutation_authorized"
  ]
}
