{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palios-taey.org/schemas/linkedin-intake-result-v1.json",
  "title": "Compact LinkedIn intake result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "taey_apply_linkedin_intake_result_v1"},
    "ok": {"const": true},
    "state": {"enum": ["captured_unclassified", "already_present"]},
    "failure_code": {"type": "null"},
    "records_observed": {"const": 1},
    "records_written": {"type": "integer", "minimum": 0, "maximum": 1},
    "job_identity_sha256": {"$ref": "#/$defs/digest"},
    "row_digest": {"$ref": "#/$defs/digest"},
    "receipt_sha256": {"$ref": "#/$defs/digest"},
    "turn_lineage_sha256": {"$ref": "#/$defs/digest"}
  },
  "required": [
    "schema",
    "ok",
    "state",
    "failure_code",
    "records_observed",
    "records_written",
    "job_identity_sha256",
    "row_digest",
    "receipt_sha256",
    "turn_lineage_sha256"
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
